# Local dev workspace — планы, решения, deferred, спайки, дампы codesynapse.
# Содержимое хранится на диске локально, в репозиторий не входит.
docs/dev/
scripts/dev/
dev/

# scripts/ — whitelist: в репо попадают только явно добавленные файлы.
# Любой новый файл в scripts/ по умолчанию ignored, пока не будет явно
# прописан в whitelist ниже. Это защищает от случайного коммита research-
# или ad-hoc-скриптов.
#
# Чтобы добавить новый скрипт в репозиторий:
#   1. Создайте файл scripts/<имя>.py
#   2. Добавьте строку `!scripts/<имя>.py` в whitelist ниже
#   3. Проверьте: git check-ignore -v scripts/<имя>.py
scripts/*
scripts/.*~

# Whitelist: CLI, необходимые для MCP/A2A/data packaging workflow
!scripts/README.md
!scripts/generate_tool_catalog.py
!scripts/validate_agent_card.py
!scripts/package_data.py
!scripts/fetch_data.py
!scripts/inject_release_urls.py

# Whitelist: smoke-проверки MCP/A2A (CI + локальный регресс)
!scripts/smoke_client.py
!scripts/smoke_mcp_tools.py
!scripts/smoke_mcp_docker.py
!scripts/smoke_a2a_agent.py
!scripts/smoke_docker.sh

# Large/local geodata; keep only small repository fixtures below
data/**
data/_releases/

!data/
!data/README.md
!data/manifest.json
!data/service_type.json
!data/service_aliases.json
!data/archetypes.csv
# Per-scenario README files (re-packaged into every archive)
!data/saint-petersburg/
!data/saint-petersburg/README.md
!data/vasilievsky-island/
!data/vasilievsky-island/README.md
!data/yuzhno-sakhalinsk/
!data/yuzhno-sakhalinsk/README.md

