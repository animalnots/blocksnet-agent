# .env.example — шаблон переменных окружения
#
# Скопируйте этот файл: cp .env.example .env
# Заполните обязательные поля (CHAT_URL, API_KEY).
# .env НЕ должен попадать в git (см. .gitignore) и в Docker-образ (см. .dockerignore).
#
# === LLM provider (для A2A-сервиса и legacy analyze_urban_question) ===
#
# OpenAI-compatible endpoint. Примеры:
#   Ollama Cloud:  CHAT_URL=https://ollama.com/v1
#   OpenRouter:    CHAT_URL=https://openrouter.ai/api/v1
#   Local Ollama:  CHAT_URL=http://localhost:11434/v1
CHAT_URL=https://ollama.com/v1
API_KEY=your_api_key_here
# Модель. Ollama Cloud требует суффикс :cloud, обычные endpoint'ы — нет.
MODEL=minimax-m3

# === Данные и runtime ===
#
# DATA_DIR — путь к локальной модели города:
#   - blocks_with_services.gpkg (geodata с кварталами и сервисами)
#   - acc_mx.pickle (матрица доступности)
#   - service_type.json, archetypes.csv и т.д.
# Если задан scenario_id (см. ниже), DATA_DIR/<scenario_id>/ должна существовать
# или быть материализована через UrbanDB materializer.
#
# OUTPUT_DIR — каталог для runtime-артефактов (run_<timestamp>_<id>/).
DATA_DIR=./data
OUTPUT_DIR=./outputs

# === Агент ===
#
# Лимит итераций одного прогона. С TPE-оптимизатором может потребоваться
# больше. Дефолт 10 подходит для большинства вопросов.
MAX_ITERATIONS=10

# Дедлайн одного прогона (секунды). После — status="partial" (легитимный
# результат, не failed). 480 = 8 минут — стандарт. Для сложных вопросов с TPE
# можно поднять до 600-900.
# DEADLINE_SEC=480

# Интервал progress-уведомлений (секунды). 0 = отключить.
# PROGRESS_INTERVAL_SEC=10.0

# === MCP-сервер (stdio) ===
#
# TTL MCP-сессий (секунды). После — сессия evicted.
SESSION_TTL_SEC=1800

# Максимум параллельных MCP-сессий (LRU). Превышение → вытеснение самой старой.
MAX_SESSIONS=8

# Регистрировать ли legacy analyze_urban_question как MCP-tool (DEPRECATED).
# Через v2.1 будет удалён — новые интеграции используют A2A run_pipeline.
ENABLE_AGENT_TOOL=true

# === A2A-сервис (HTTP) ===
#
# A2A_HOST — bind address. 0.0.0.0 для Docker/prod, 127.0.0.1 для локального dev.
A2A_HOST=0.0.0.0
A2A_PORT=8080

# Public URL для Agent Card. Если A2A за reverse-proxy — укажи https URL.
# A2A_PUBLIC_URL=https://example.com/agents/blocksnet

# Лимит параллельных A2A-задач. Превышение → задача в submitted, ждёт семафора.
A2A_MAX_CONCURRENT_TASKS=2

# TTL завершённых A2A-задач (секунды).
A2A_TASK_TTL_SEC=3600

# Интервал TaskStatusUpdateEvent (SSE-стрим). 0 = отключить.
# A2A_PROGRESS_INTERVAL_SEC=10.0

# === Auth (опционально) ===
#
# Включить Bearer-auth (A2A-сервер). При true обязателен MAS_BEARER_TOKEN.
# Сейчас реализован только StaticTokenVerifier (для dev). JWT — TODO (D1).
# A2A_AUTH_ENABLED=false

# Статический токен. Если задан — обязателен при A2A_AUTH_ENABLED=true.
# Генерируй: python -c "import secrets; print(secrets.token_urlsafe(32))"
# A2A_MAS_BEARER_TOKEN=

# === UrbanDB materializer (опционально) ===
#
# Реальная интеграция с UrbanDB — TODO (D1). Сейчас materializer в
# blocksnet_agent/context.py — in-process factory для тестов.
# URBANDB_URL=
# URBANDB_TOKEN=

# === MCP-сервер: транспорт (опционально) ===
#
# stdio (по умолчанию) — для локальных MCP-клиентов; http — streamable-http
# на HOST:PORT + MCP_PATH с GET /health (Synapse и другие сетевые клиенты).
# MCP_HOST/MCP_PORT — синонимы HOST/PORT, если те заняты в общем .env.
# TRANSPORT=stdio
# HOST=127.0.0.1
# PORT=8001
# MCP_PATH=/mcp
